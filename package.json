{
  "name": "reticula",
  "version": "1.0.0",
  "description": "Retícula: aim trainer 3D (navegador, Windows y Android)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/chakra-petch": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^43.8.2",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "author": "KmiloRosero"
}
